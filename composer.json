{
    "name": "power-vending/laravel-api-query-builder",
    "description": "Laravel API query builder - forked and customized from nealarec/laravel-json-query-builder",
    "keywords": [
        "php",
        "laravel",
        "query-builder",
        "api",
        "json",
        "power-vending"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Power Vending",
            "email": "dev@powervending.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "doctrine/dbal": "^3.0|^4.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.4.4",
        "fakerphp/faker": "^1.9.1",
        "orchestra/testbench": "^8.5|^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "PowerVending\\LaravelApiQueryBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PowerVending\\LaravelApiQueryBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PowerVending\\LaravelApiQueryBuilder\\ApiQueryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}